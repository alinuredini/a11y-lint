{
  "name": "a11y-lint",
  "version": "0.1.0",
  "description": "Framework-agnostic WCAG 2.2 linter: static template rules, design-token contrast, runtime axe scans and a conformance report.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "linter",
    "axe",
    "contrast",
    "design-tokens"
  ],
  "license": "MIT",
  "author": "Ali Nuredini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alinuredini/a11y-lint.git"
  },
  "homepage": "https://github.com/alinuredini/a11y-lint#readme",
  "bugs": {
    "url": "https://github.com/alinuredini/a11y-lint/issues"
  },
  "type": "module",
  "bin": {
    "a11y-lint": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@angular/compiler": "^22.2.4",
    "@astrojs/compiler": "^4.0.0",
    "@babel/parser": "^8.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "culori": "^4.0.2",
    "parse5": "^8.0.1",
    "postcss": "^8.5.32",
    "postcss-scss": "^4.0.9",
    "svelte": "^5.57.3",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4.8",
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
