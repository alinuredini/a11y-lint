{
  "color": {
    "$type": "color",
    "gray": { "100": { "$value": "#f3f4f6" }, "400": { "$value": "#9ca3af" }, "900": { "$value": "#111827" } },
    "text": {
      "primary": { "$value": "{color.gray.900}" },
      "muted": { "$value": "{color.gray.400}" }
    },
    "bg": { "default": { "$value": "#ffffff" }, "subtle": { "$value": "{color.gray.100}" } },
    "primary": { "$value": "#2563eb" },
    "on-primary": { "$value": "#ffffff" },
    "focus": { "ring": { "$value": "#d1d5db" } }
  }
}
